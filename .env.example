# Optional for developers; end users configure these inside the desktop app.
# PowerShell: set environment variables before running npm start.
# This file is a reference only; it is NOT automatically loaded.
VISION_BASE_URL=https://api.openai.com/v1
VISION_MODEL=your-vision-model
VISION_API_KEY=
# Provider: openai, deepseek, claude, custom
VISION_PROVIDER=openai
# Protocol: openai or anthropic
VISION_PROTOCOL=openai
# Connection: api or cli
AI_MODE=api
# CLI: codex, claude. Empty path searches PATH.
CLI_KIND=codex
CLI_PATH=
CLI_MODEL=
