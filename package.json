{
  "name": "deskmate",
  "version": "0.1.0",
  "private": true,
  "description": "Deskmate — 看懂每一步。可连接自选模型 API 的桌面课程助教。",
  "author": "dmkom522",
  "repository": {
    "type": "git",
    "url": "https://github.com/dmkom522/Deskmate.git"
  },
  "type": "module",
  "main": "src/main.mjs",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build:ui": "node scripts/build-ui.mjs",
    "prestart": "npm run build:ui",
    "predev": "npm run build:ui",
    "pretest:desktop": "npm run build:ui",
    "prepack": "npm run build:ui",
    "predist:win": "npm run build:ui",
    "predist:mac": "npm run build:ui",
    "predist:linux": "npm run build:ui",
    "start": "electron .",
    "dev": "electron .",
    "test": "node --test tests/*.test.mjs",
    "test:desktop": "playwright test",
    "check": "node scripts/check.mjs",
    "pack": "electron-builder --dir",
    "dist:win": "electron-builder --win nsis --x64 --publish never",
    "dist:mac": "electron-builder --mac dmg --publish never",
    "dist:linux": "electron-builder --linux AppImage --publish never"
  },
  "build": {
    "appId": "app.deskmate.desktop",
    "productName": "Deskmate",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "src/**/*",
      "package.json",
      "LICENSE",
      "assets/icon.ico"
    ],
    "artifactName": "Deskmate-${version}-${os}-${arch}.${ext}",
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico",
      "signAndEditExecutable": true
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Deskmate"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.education",
      "extendInfo": {
        "NSScreenCaptureUsageDescription": "Deskmate 使用您选择的窗口画面作为课程问答的上下文。"
      }
    },
    "linux": {
      "target": "AppImage",
      "category": "Education"
    }
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "electron": "44.9.0",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "katex": "0.19.0",
    "markdown-it": "15.0.3"
  }
}
